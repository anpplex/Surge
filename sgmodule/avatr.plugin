#!name = 阿维塔签到
#!desc = 打开一次阿维塔 App 抓取凭证。loginToken 约 24 小时，refreshToken 约 30 天。不足 6 小时自动续期，每天 8:05–21:40 随机签到，22:17 补签。
#!author = anpplex
#!homepage = https://github.com/anpplex/Surge

[Script]
http-request ^https?:\/\/appserver-view\.avatr\.com\/v6\/base-view\/auth\/getNewToken script-path=https://raw.githubusercontent.com/anpplex/Surge/main/Script/avatr_surge.js, requires-body=true, timeout=10, argument=mode=capture, tag=阿维塔续期抓取
http-request ^https?:\/\/(?:m\.avatr\.com\/api\/|appserver-view\.avatr\.com\/(?!tbox\/|v6\/base-view\/auth\/getNewToken)) script-path=https://raw.githubusercontent.com/anpplex/Surge/main/Script/avatr_surge.js, requires-body=false, timeout=10, argument=mode=capture, tag=阿维塔抓取
http-response ^https?:\/\/([a-z0-9-]+\.)*avatr\.com\/(?:api\/auth\/.*(login|token)|v6\/base-view\/auth\/getNewToken) script-path=https://raw.githubusercontent.com/anpplex/Surge/main/Script/avatr_surge.js, requires-body=true, timeout=10, argument=mode=response, tag=阿维塔登录响应
cron "7,33,51 8-21 * * *" script-path=https://raw.githubusercontent.com/anpplex/Surge/main/Script/avatr_surge.js, timeout=30, argument=mode=cron, tag=阿维塔签到
cron "17 22 * * *" script-path=https://raw.githubusercontent.com/anpplex/Surge/main/Script/avatr_surge.js, timeout=30, argument=mode=catchup, tag=阿维塔补签
generic script-path=https://raw.githubusercontent.com/anpplex/Surge/main/Script/avatr_surge.js, timeout=30, argument=mode=now, tag=阿维塔立即签到
generic script-path=https://raw.githubusercontent.com/anpplex/Surge/main/Script/avatr_surge.js, timeout=10, argument=mode=panel, tag=阿维塔面板

[Panel]
阿维塔签到 = script-name=阿维塔面板, title="阿维塔签到", content="打开一次阿维塔 App", style=info, update-interval=600

[Mitm]
hostname = appserver-view.avatr.com, m.avatr.com
