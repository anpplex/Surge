[MITM]
hostname = mobile.avp.adscloud.huawei.com

[Rewrite Local]
# POST 方法，直接替换响应
^https:\/\/mobile\.avp\.adscloud\.huawei\.com\/mobile\/foundation-service\/v1\/vpd-compliance\/check$ url script-response-body https://raw.githubusercontent.com/anpplex/Surge/main/fixed_vpd_response.json

[Script Local]
# 如果需要更多动态替换逻辑，仍支持脚本扩展
