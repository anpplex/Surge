[MITM]
hostname = mobile.avp.adscloud.huawei.com

[Script]
vpd-bypass-distance = type=http-response,pattern=^https://mobile\.avp\.adscloud\.huawei\.com/mobile/foundation-service/v1/vpd-compliance/check,requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/anpplex/Surge/main/Script/vpd_unlock.js
